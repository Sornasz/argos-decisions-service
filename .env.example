PORT=3002

# Armazenamento: "sql" (padrão) ou "memory", este só para desenvolvimento e proibido com NODE_ENV=production.
DECISION_STORE=sql
SQL_CONNECTION_STRING=

# Receptor do Service Bus: defina as três variáveis ou nenhuma. Sem elas a API sobe sem o receptor.
SERVICEBUS_CONNECTION=
SERVICEBUS_TOPIC_NAME=transaction-scored
SERVICEBUS_SUBSCRIPTION_NAME=decision-audit

# Alerta de fraude pela Gmail API (OAuth2). Sem as credenciais, o alerta só vai para o log.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
FRAUD_ALERT_RECIPIENTS=
